{
  "expo": {
    "name": "Sconet",
    "slug": "sconet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sconet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.binarykoan.sconet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5046E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.binarykoan.sconet"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5046e6",
          "dark": {
            "backgroundColor": "#5046e6"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Sconet to use the camera to capture receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1792e303-fab3-41af-ab3c-024d8684fb56"
      }
    }
  }
}
